# Copy to .env (same directory) and fill in real values.
# .env is gitignored - never commit real API keys.

# Which model writes the narrative: groq (hosted) or ollama (local).
# Only the selected provider has to be configured.
LLM_PROVIDER=ollama

# --- groq ------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Measured ceiling for qwen3.8-27b's 1000 OTPM cap - see CLAUDE.md gotcha #5.
MAX_EVENTS_FOR_ANALYSIS=15
MAX_COMPLETION_TOKENS=950

# --- ollama (local, no API key, no rate limit) -----------------------------
# The container reaches the host's Ollama through host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
# Local budgets are separate from the Groq ones above and are only read when
# LLM_PROVIDER=ollama. qwen3.5:9b needs 3000 / 1200: at a 600-token map cap
# map-reduce batches were cut off (CLAUDE.md). qwen2.5:7b-instruct ran at 2400 / 600.
OLLAMA_MAX_EVENTS_FOR_ANALYSIS=50
OLLAMA_MAX_COMPLETION_TOKENS=3000
OLLAMA_MAP_COMPLETION_TOKENS=1200
# Context window for the native /api/chat call. The OpenAI-compatible /v1
# endpoint has no way to set this and silently truncates the prompt to the
# server default of 4096 - dropping the system prompt - which is why the
# native endpoint is used. 16384 holds a 50-event prompt plus the output.
OLLAMA_NUM_CTX=16384
# A local 7B generates for tens of seconds and loads the model on first call.
OLLAMA_TIMEOUT=600

# --- login (FR-1) ------------------------------------------------------------
# Accounts are made with tools/create_user.py; there is no sign-up page.
# Where "can't sign in?" on the login page points - a mailto: or helpdesk URL.
IT_CONTACT_URL=
# Signs the session cookie. Leave empty to have one generated once and kept
# in the data volume; set it only if several containers must share sessions.
SESSION_SECRET=
SESSION_HOURS=12

# --- Sign in with Google (docs/specs/google_login.md) ---------------------------
# Off unless all four are set. Make an OAuth client ID (type "Web application")
# in Google Cloud Console > APIs & Services > Credentials, with the authorised
# redirect URI  <PUBLIC_URL>/api/auth/google/callback  (exactly; Google takes
# https + a domain name, or http://localhost - not a bare IP address).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Workspace domains whose people may sign in, comma separated. Someone
# with no account yet gets one as an analyst; personal @gmail.com never can.
GOOGLE_ALLOWED_DOMAINS=
# The address analysts open, no trailing slash, e.g. https://forensic.example.com
PUBLIC_URL=
