.env
__pycache__/
*.pyc

# Build output. The UI source is frontend/; static/ is what Vite emits into
# (and what the Dockerfile rebuilds in its own stage), so it is generated,
# never edited by hand.
static/
frontend/node_modules/

# A 2.7GB checkout of an unrelated repo, cloned into the working directory.
metabase/

# Synthetic demo logs (regenerate with the gen_* scripts) - data, not source.
logtest/

# Functional-spec PDFs are external reference, kept out of the code repo.
*.pdf
